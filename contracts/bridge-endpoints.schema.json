{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-max.dev/contracts/bridge-endpoints.schema.json",
  "title": "CAD-MAX process-level bridge endpoint data",
  "oneOf": [
    { "$ref": "#/$defs/health" },
    { "$ref": "#/$defs/version" },
    { "$ref": "#/$defs/capabilities" },
    { "$ref": "#/$defs/heartbeat" }
  ],
  "$defs": {
    "pluginState": {
      "type": "string",
      "enum": ["STOPPED", "STARTING", "LISTENING", "READY", "DEGRADED", "FAILED", "STOPPING"]
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service", "instanceId", "pluginState", "autocadConnected", "developmentHost",
        "documentAccess", "dwgRead", "dwgWrite", "readOnly", "allowWrite", "allowScript"
      ],
      "properties": {
        "service": { "type": "string" },
        "instanceId": { "type": "string", "format": "uuid" },
        "pluginState": { "$ref": "#/$defs/pluginState" },
        "autocadConnected": { "type": "boolean" },
        "developmentHost": { "type": "boolean" },
        "documentAccess": { "const": false },
        "dwgRead": { "const": false },
        "dwgWrite": { "const": false },
        "readOnly": { "const": true },
        "allowWrite": { "const": false },
        "allowScript": { "const": false }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion", "schemaVersion", "pluginVersion", "adapterVersion", "autocadYear",
        "autocadProductVersion", "runtimeTarget", "instanceId", "capabilityRevision",
        "autocadConnected", "developmentHost"
      ],
      "properties": {
        "protocolVersion": { "const": "1.0" },
        "schemaVersion": { "const": "1.0" },
        "pluginVersion": { "type": "string" },
        "adapterVersion": { "type": "string" },
        "autocadYear": { "type": "integer", "minimum": 0 },
        "autocadProductVersion": { "type": "string" },
        "runtimeTarget": { "type": "string" },
        "instanceId": { "type": "string", "format": "uuid" },
        "capabilityRevision": { "type": "string", "minLength": 1 },
        "autocadConnected": { "type": "boolean" },
        "developmentHost": { "type": "boolean" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId", "capabilityRevision", "pluginState", "autocadConnected",
        "developmentHost", "capabilities"
      ],
      "properties": {
        "instanceId": { "type": "string", "format": "uuid" },
        "capabilityRevision": { "type": "string", "minLength": 1 },
        "pluginState": { "$ref": "#/$defs/pluginState" },
        "autocadConnected": { "type": "boolean" },
        "developmentHost": { "type": "boolean" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bridge.health", "bridge.version", "bridge.capabilities", "bridge.heartbeat",
            "bridge.contextDispatch", "bridge.contextProbe", "documentContext.available",
            "drawing.active_document", "drawing.list_documents", "drawing.units", "drawing.bounds",
            "drawing.layouts", "query.entity_count", "query.count_by_type", "query.list_entities",
            "query.entity_summary", "query.resolve_handle", "query.measure_geometry", "layer.list_layers",
            "block.list_definitions", "block.list_references", "block.list_attributes",
            "style.list_text_styles", "style.list_dimension_styles", "style.list_linetypes",
            "selection.get_pickfirst", "preview.render_pdf", "preview.render_png", "dwg.read",
            "dwg.write", "script", "command"
          ],
          "properties": {
            "bridge.health": { "const": true },
            "bridge.version": { "const": true },
            "bridge.capabilities": { "const": true },
            "bridge.heartbeat": { "const": true },
            "bridge.contextDispatch": { "type": "boolean" },
            "bridge.contextProbe": { "type": "boolean" },
            "documentContext.available": { "type": "boolean" },
            "drawing.active_document": { "const": false },
            "drawing.list_documents": { "const": false },
            "drawing.units": { "const": false },
            "drawing.bounds": { "const": false },
            "drawing.layouts": { "const": false },
            "query.entity_count": { "const": false },
            "query.count_by_type": { "const": false },
            "query.list_entities": { "const": false },
            "query.entity_summary": { "const": false },
            "query.resolve_handle": { "const": false },
            "query.measure_geometry": { "const": false },
            "layer.list_layers": { "const": false },
            "block.list_definitions": { "const": false },
            "block.list_references": { "const": false },
            "block.list_attributes": { "const": false },
            "style.list_text_styles": { "const": false },
            "style.list_dimension_styles": { "const": false },
            "style.list_linetypes": { "const": false },
            "selection.get_pickfirst": { "const": false },
            "preview.render_pdf": { "const": false },
            "preview.render_png": { "const": false },
            "dwg.read": { "const": false },
            "dwg.write": { "const": false },
            "script": { "const": false },
            "command": { "const": false }
          }
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId", "heartbeatSequence", "timestampUtc", "uptimeMs", "pluginState",
        "capabilityRevision", "autocadConnected", "developmentHost",
        "contextDispatcherState", "queueDepth", "inFlightCount", "modal",
        "hasActiveDocument", "lastDispatchStatus"
      ],
      "properties": {
        "instanceId": { "type": "string", "format": "uuid" },
        "heartbeatSequence": { "type": "integer", "minimum": 1 },
        "timestampUtc": { "type": "string", "format": "date-time" },
        "uptimeMs": { "type": "integer", "minimum": 0 },
        "pluginState": { "$ref": "#/$defs/pluginState" },
        "capabilityRevision": { "type": "string", "minLength": 1 },
        "autocadConnected": { "type": "boolean" },
        "developmentHost": { "type": "boolean" },
        "contextDispatcherState": {
          "type": "string",
          "enum": ["NOT_READY", "READY", "STOPPING"]
        },
        "queueDepth": { "type": "integer", "minimum": 0, "maximum": 32 },
        "inFlightCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "modal": { "type": "boolean" },
        "hasActiveDocument": { "type": "boolean" },
        "lastDispatchStatus": {
          "type": "string",
          "enum": [
            "NONE", "OK", "NO_ACTIVE_DOCUMENT", "DOCUMENT_BUSY",
            "APPLICATION_MODAL", "TIMEOUT", "CANCELLED", "FAILED"
          ]
        }
      }
    }
  }
}
