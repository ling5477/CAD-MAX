{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-max.dev/contracts/cad-command.schema.json",
  "title": "CAD-MAX command request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "traceId",
    "command",
    "parameters"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "traceId": {
      "type": "string",
      "format": "uuid"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "parameters": {
      "type": "object"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000,
      "default": 30000
    }
  }
}
