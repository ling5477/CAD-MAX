{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-max.dev/contracts/cad-result.schema.json",
  "title": "CAD-MAX result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "traceId",
    "success",
    "status",
    "errorCode",
    "message",
    "data",
    "warnings",
    "durationMs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "traceId": {
      "type": "string",
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "errorCode": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/status"
        }
      ]
    },
    "message": {
      "type": "string"
    },
    "data": {},
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "OK",
        "BACKEND_UNAVAILABLE",
        "BACKEND_NOT_CONFIGURED",
        "INVALID_ARGUMENT",
        "PATH_NOT_ALLOWED",
        "READ_ONLY",
        "NOT_IMPLEMENTED",
        "TIMEOUT",
        "CANCELLED",
        "DISPATCHER_NOT_READY",
        "INSTANCE_MISMATCH",
        "NO_ACTIVE_DOCUMENT",
        "DOCUMENT_NOT_ACTIVE",
        "DOCUMENT_DESTROYED",
        "DOCUMENT_NOT_FOUND",
        "APPLICATION_MODAL",
        "DOCUMENT_BUSY",
        "QUEUE_FULL",
        "MAIN_THREAD_DISPATCH_FAILED",
        "COMMAND_CONTEXT_FAILED",
        "RESULT_LIMIT_EXCEEDED",
        "AUTOCAD_DATA_INVALID",
        "AUTOCAD_API_ERROR",
        "INTERNAL_ERROR",
        "UNAUTHORIZED",
        "METHOD_NOT_ALLOWED",
        "ROUTE_NOT_FOUND",
        "QUERY_NOT_ALLOWED",
        "REQUEST_BODY_NOT_ALLOWED",
        "HEADERS_TOO_LARGE",
        "REQUEST_TARGET_TOO_LONG",
        "REQUEST_TIMEOUT",
        "SERVER_BUSY",
        "BRIDGE_NOT_READY",
        "BRIDGE_STOPPING",
        "NOT_CONNECTED",
        "SCHEMA_MISMATCH",
        "TOKEN_NOT_CONFIGURED",
        "TOKEN_CONFIG_INVALID",
        "TOKEN_FILE_INSECURE",
        "TOKEN_INVALID",
        "TOKEN_UNAVAILABLE"
      ]
    }
  }
}
