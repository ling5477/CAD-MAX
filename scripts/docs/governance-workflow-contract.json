        "http_binding"
      ],
      "currentPhase": "PHASE_1",
      "phaseStatus": "IN_PROGRESS|NOT_FROZEN",
      "acceptedWorkBatchStatus": "ACCEPTED|CI_GREEN",
      "workBatches": [
        "PHASE_1_PLAN",
        "PHASE_1_1_AUTOCAD_PLUGIN_BOOTSTRAP",
        "PHASE_1_2_LOOPBACK_BRIDGE_LIFECYCLE",
        "PHASE_1_3_DOCUMENT_CONTEXT_DISPATCH",
